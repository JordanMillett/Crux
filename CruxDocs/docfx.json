{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../",
          "files": [
            "/CruxEngine/CruxEngine.csproj"
          ]
        }
      ],
      "dest": "api",
      "includePrivateMembers": true
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
          "logo.png"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "CruxDocs",
      "_appTitle": "CruxDocs",
      "_appLogoPath": "logo.png",
      "_appFaviconPath": "logo.png",
      "_enableSearch": true,
      "pdf": false
    },
    "overwrite": [
      {
        "files": ["**/toc.yml"]
      }
    ]
  }
}